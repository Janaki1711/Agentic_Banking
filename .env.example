# ==============================================================================
# OmniCFO: Agentic Banking — Environment Configuration
# Airwallex Sandbox + Omni-Channel AI Agent Gateway
# ==============================================================================

# Airwallex Sandbox API Credentials
# Get these from: https://sandbox.airwallex.com -> Account -> Developer -> API keys
AIRWALLEX_CLIENT_ID=your_sandbox_client_id_here
AIRWALLEX_API_KEY=your_sandbox_api_key_here
AIRWALLEX_API_URL=https://api.sandbox.airwallex.com

# Model Context Protocol (MCP) Server URLs
AIRWALLEX_DOCS_MCP_URL=https://mcp.sandbox.airwallex.com/docs
AIRWALLEX_DEV_MCP_URL=https://mcp.sandbox.airwallex.com/developer

# Deterministic Financial Guardrails
TREASURY_MIN_RESERVE_USD=10000.00
MAX_AUTONOMOUS_TRANSFER_USD=2500.00
MONTHLY_SAAS_CARD_LIMIT_USD=500.00

# Tel-Agent AI Receptionist & Multi-Channel Gateway
TEL_AGENT_ENABLED=true
TEL_AGENT_URL=http://localhost:38471
TEL_AGENT_API_KEY=your_telagent_api_key
TEL_AGENT_SIP_TRUNK=+917483799325

# Twilio & UltraMsg Notifications (Optional live telephony & WhatsApp fallback)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_VERIFIED_TO_NUMBER=+917483799325
ULTRAMSG_INSTANCE_ID=instance192643
ULTRAMSG_TOKEN=your_ultramsg_token
